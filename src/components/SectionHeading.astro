---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { number, eyebrow, title, href, linkLabel = '查看全部' } = Astro.props;
---

<header class="section-heading">
  <div class="section-index" aria-hidden="true">{number}</div>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {href && <a class="arrow-link" href={href}>{linkLabel}<span aria-hidden="true">↗</span></a>}
</header>
