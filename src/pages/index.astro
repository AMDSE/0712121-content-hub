---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostCard from '../components/PostCard.astro';
import { formatDate } from '../data/content';
import { getSiteContent } from '../lib/directus';
import heroArtwork from '../assets/editorial-workbench-hero.png';

const { categories, posts, projects, series, settings } = await getSiteContent();
const featuredPost = posts.find((post) => post.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.slug !== featuredPost?.slug).slice(0, 3);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy" data-reveal>
      <div class="hero-kicker">
        <span class="live-dot"></span>
        <span>{settings.heroKicker}</span>
        <span>VOL. 01 / 2026—NOW</span>
      </div>
      <p class="hero-deck">把搭建、试错与灵感，整理成一份可以反复翻阅的私人档案。</p>
      <h1 id="hero-title">
        不是博客，<br />是一张仍在<br /><span class="hero-title-accent">生长的工作台。</span>
      </h1>
      <p class="hero-intro">{settings.heroDescription}</p>
      <div class="hero-actions">
        <a class="primary-button" href="#start">打开今日索引 <span>↘</span></a>
        <button class="text-button" type="button" data-search-open>检索全部档案 <kbd>⌘ K</kbd></button>
      </div>
    </div>

    <figure class="hero-art" data-reveal>
      <div class="hero-art-frame">
        <Image
          src={heroArtwork}
          alt="由老式显示器、服务器、纸张、压花与透明亚克力组成的数字档案工作台拼贴"
          widths={[480, 720, 960, 1122]}
          sizes="(max-width: 900px) 92vw, 44vw"
          format="webp"
          quality={84}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <span class="hero-art-tab">PRIVATE ARCHIVE / 0712121</span>
      <figcaption>
        <span>图像档案 001</span>
        <strong>WORKBENCH<br />STILL LIFE</strong>
      </figcaption>
      <div class="hero-float-card" aria-hidden="true">
        <span>ARCHIVE.STATUS</span>
        <strong>ONLINE</strong>
        <small>{String(settings.contentTotal).padStart(3, '0')} NOTES · {String(series.length).padStart(2, '0')} SERIES</small>
      </div>
    </figure>
  </section>

  <nav class="entry-board" id="start" aria-label="快速探索">
    <div class="entry-board-intro">
      <span class="eyebrow">START HERE / 路径</span>
      <strong>今天想从<br />哪里翻起？</strong>
      <small>四条入口，一座持续更新的档案室</small>
    </div>
    <a href="/notes/?category=建站与服务器" class="accent-lime">
      <span>01</span><div><strong>从零搭站</strong><small>服务器、域名与自动发布</small></div><i>↗</i>
    </a>
    <a href="/notes/?category=AIGC与工作流" class="accent-blue">
      <span>02</span><div><strong>整理 AI 工作流</strong><small>工具、方法与真实使用记录</small></div><i>↗</i>
    </a>
    <a href="/lab/" class="accent-orange">
      <span>03</span><div><strong>进入实验台</strong><small>能点、能跑、仍在生长的小东西</small></div><i>↗</i>
    </a>
    <a href="/notes/" class="accent-pink">
      <span>04</span><div><strong>翻全部索引</strong><small>按主题寻找每一份公开档案</small></div><i>↗</i>
    </a>
  </nav>

  <div class="marquee" aria-hidden="true">
    <div>
      <span>ASTRO</span><i>✦</i><span>DIRECTUS</span><i>✦</i><span>SELF-HOSTED</span><i>✦</i><span>FIELD NOTES</span><i>✦</i><span>EXPERIMENTS</span><i>✦</i><span>DIGITAL ARCHIVE</span><i>✦</i>
      <span>ASTRO</span><i>✦</i><span>DIRECTUS</span><i>✦</i><span>SELF-HOSTED</span><i>✦</i><span>FIELD NOTES</span><i>✦</i><span>EXPERIMENTS</span><i>✦</i><span>DIGITAL ARCHIVE</span><i>✦</i>
    </div>
  </div>

  <section class="content-section latest-section" data-reveal>
    <SectionHeading number="01" eyebrow="NEW IN THE ARCHIVE" title="刚整理好的档案" href="/notes/" />
    <div class="latest-grid">
      {featuredPost && (
        <article class="featured-story accent-lime">
          <a class="story-link" href={`/notes/${featuredPost.slug}/`} aria-label={featuredPost.title}></a>
          <div class="story-visual">
            <div class="story-poster" aria-hidden="true">
              <span>READING PATH / 01</span>
              <strong>BUILD<br />YOUR<br />OWN.</strong>
              <small>DIRECTUS → ASTRO → EDGE</small>
            </div>
            <div class="story-photo" aria-hidden="true">
              <Image src={heroArtwork} alt="" width={430} format="webp" quality={78} loading="lazy" />
            </div>
            <span class="visual-stamp">FIELD NOTE<br />NO. 001</span>
          </div>
          <div class="story-copy">
            <span class="category-pill">{featuredPost.category}</span>
            <h3>{featuredPost.title}</h3>
            <p>{featuredPost.excerpt}</p>
            <div class="story-meta"><span>{formatDate(featuredPost.date)}</span><span>{featuredPost.readingTime}</span><span aria-hidden="true">↗</span></div>
          </div>
        </article>
      )}
      <div class="latest-list">
        {latestPosts.map((post) => <PostCard post={post} compact />)}
      </div>
    </div>
  </section>

  <section class="content-section series-section" data-reveal>
    <SectionHeading number="02" eyebrow="ONGOING FILES" title="还在继续写的专题" href="/series/" />
    <div class="series-list">
      {series.map((item, index) => (
        <article class:list={['series-row', `accent-${item.accent}`]} id={item.slug}>
          <a class="story-link" href={`/series/#${item.slug}`} aria-label={item.title}></a>
          <span class="series-number">{String(index + 1).padStart(2, '0')}</span>
          <div class="series-main"><span class="series-status"><i></i>{item.status}</span><h3>{item.title}</h3><p>{item.description}</p></div>
          <div class="series-count"><strong>{String(item.issueCount).padStart(2, '0')}</strong><span>篇内容</span></div>
          <span class="series-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section lab-section" data-reveal>
    <SectionHeading number="03" eyebrow="ON THE WORKBENCH" title="实验台上的半成品" href="/lab/" linkLabel="进入实验室" />
    <div class="project-grid">
      {projects.map((project, index) => (
        <article class:list={['project-card', `accent-${project.accent}`, { 'has-photo': index === 0 }]} id={project.slug}>
          <a class="story-link" href={`/lab/#${project.slug}`} aria-label={project.title}></a>
          <div class="project-art" aria-hidden="true">
            {index === 0 && <Image src={heroArtwork} alt="" width={560} format="webp" quality={76} loading="lazy" />}
            <span class="project-mark">{project.mark}</span>
            <span class="project-index">0{index + 1} / WIP</span>
          </div>
          <div class="project-copy"><span>{project.label}</span><h3>{project.title}</h3><p>{project.description}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section index-section" data-reveal>
    <SectionHeading number="04" eyebrow="KNOWLEDGE INDEX" title="按主题翻阅" href="/notes/" linkLabel="打开全部索引" />
    <div class="category-layout">
      <div class="category-intro">
        <span class="index-note">NOT A FEED<br />BUT AN INDEX</span>
        <p>这里不是一条阅后即逝的信息流。每篇内容都会进入长期维护的主题，旧文章也会继续修订、连接并长出新的分支。</p>
        <div class="index-total"><strong>{String(settings.contentTotal).padStart(3, '0')}</strong><span>条公开内容<br />仍在增加</span></div>
      </div>
      <div class="category-list">
        {categories.map((category, index) => (
          <a href={`/notes/?category=${encodeURIComponent(category.name)}`}>
            <span>{String(index + 1).padStart(2, '0')}</span><strong>{category.name}</strong><em>{category.code}</em><b>{category.count}</b><i>→</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="now-strip" data-reveal>
    <div><span class="status-dot"></span><p class="eyebrow">NOW / 2026.08</p></div>
    <p>正在把折腾过程整理成可以复用的公开档案：内容住在 Directus，页面由 Astro 生成，图片进入 R2，再由 Cloudflare 送到访客面前。</p>
    <a href="/about/">查看站点说明 ↗</a>
  </section>
</BaseLayout>
