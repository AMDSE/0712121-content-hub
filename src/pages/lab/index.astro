---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteContent } from '../../lib/directus';

const { projects } = await getSiteContent();
---

<BaseLayout title="实验室 — 0712121" description="可以点击、使用和继续生长的小型 Web 实验与工具。">
  <header class="archive-hero lab-hero">
    <p class="eyebrow">PLAYGROUND / 03</p>
    <h1>想法要能<br /><em>跑起来。</em></h1>
    <p>这里收留文章装不下的东西：小工具、交互实验、清单，以及还没有名字的半成品。</p>
  </header>
  <section class="lab-archive">
    {projects.map((project, index) => (
      <article class:list={['lab-detail', `accent-${project.accent}`]} id={project.slug}>
        <div class="lab-detail-art"><span>{project.mark}</span><i>0{index + 1}</i><div></div></div>
        <div class="lab-detail-copy"><span>{project.label}</span><h2>{project.title}</h2><p>{project.description}</p><button type="button" disabled>即将开放</button></div>
      </article>
    ))}
  </section>
</BaseLayout>
