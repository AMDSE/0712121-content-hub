---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, type Post } from '../../data/content';
import { getSiteContent } from '../../lib/directus';

export async function getStaticPaths() {
  const { posts } = await getSiteContent();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
---

<BaseLayout title={`${post.title} — 0712121`} description={post.excerpt} type="article">
  <article class="article-page">
    <header class:list={['article-header', `accent-${post.accent}`]}>
      <a class="article-back" href="/notes/">← 返回全部笔记</a>
      <span class="category-pill">{post.category}</span>
      <h1>{post.title}</h1>
      <p>{post.excerpt}</p>
      <div class="article-meta"><time datetime={post.date}>{formatDate(post.date)}</time><span>{post.readingTime}</span><span>{post.tags.join(' · ')}</span></div>
    </header>
    <div class="article-body">
      <aside class="article-toc">
        <span>文章信息</span>
        <a href={`/notes/?category=${encodeURIComponent(post.category)}`}>{post.category}</a>
        {post.seriesTitle && <span>{post.seriesTitle}</span>}
        {post.tags.map((tag) => <span>#{tag}</span>)}
      </aside>
      <div class="prose" set:html={post.content ?? `<p>${post.excerpt}</p>`}></div>
    </div>
  </article>
</BaseLayout>
