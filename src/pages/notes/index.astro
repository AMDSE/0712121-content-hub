---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSiteContent } from '../../lib/directus';

const { categories, posts } = await getSiteContent();
---

<BaseLayout title="全部笔记 — 0712121" description="建站、AIGC、设计与数字生活的全部笔记。">
  <header class="archive-hero">
    <p class="eyebrow">知识索引 / KNOWLEDGE INDEX / 01</p>
    <h1>先找到一条线索，<br />再顺着它<em>继续翻。</em></h1>
    <p>这里收录全部公开笔记。可以按时间浏览，也可以沿着分类与标签继续探索。</p>
  </header>
  <section class="archive-shell">
    <aside class="archive-filter">
      <span>按主题筛选 / FILTER</span>
      <a href="/notes/" class="active">全部内容 <b>{posts.length}</b></a>
      {categories.map((category) => <a href={`?category=${encodeURIComponent(category.name)}`}>{category.name}<b>{category.count}</b></a>)}
    </aside>
    <div class="archive-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
